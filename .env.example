# Variables del chatbot GS Bot.
# Este archivo es una PLANTILLA: no pongas valores reales aqui, se sube a Git.
# Los valores reales van en Vercel -> Settings -> Environment Variables,
# y en local en un archivo .env (que .gitignore ya excluye).

# Obligatoria. API key de OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcionales (tienen valor por defecto en el codigo)
# Modelo. Por defecto gpt-4.1-mini. Alternativas: gpt-4o-mini (mas barato), gpt-4.1 (mas capaz)
OPENAI_MODEL=gpt-4.1-mini
# Tope de tokens por respuesta. Sube el costo si lo aumentas.
OPENAI_MAX_TOKENS=600
# 0 = literal y repetitivo, 1 = mas suelto. 0.4 es un buen punto para soporte.
OPENAI_TEMPERATURE=0.4
# ── Leads (formulario + chatbot) → Supabase, tabla public.leads ──
# URL del proyecto (no es secreta).
SUPABASE_URL=https://ahvrhfpthmcwbmzlrwpy.supabase.co
# SECRETA. Supabase → Project Settings → API Keys → Secret keys (sb_secret_...).
# Solo en Vercel (Production). Nunca en el navegador ni en Git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# SECRETA. Cadena aleatoria larga; Vercel la envia al cron /api/keepalive.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Aviso por correo de cada lead nuevo (Resend) ──
# SECRETA. https://resend.com/api-keys (permiso: Sending access).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Destinatario(s) del aviso. Varios, separados por coma.
LEAD_NOTIFY_TO=wilyer.arias@growingsolutions.online
# Remitente. El dominio debe estar verificado en Resend.
LEAD_NOTIFY_FROM=Growing Solutions <no-reply@notify.growingsolutions.online>

# ── Configuracion publica (la entrega GET /api/config al navegador) ──
# No son secretas, pero viven aqui para no escribirlas en el codigo.
# Enlace de agenda (Google Calendar appointment schedule o Calendly). Solo https.
# Sin valor, los botones "Agenda una llamada" llevan al formulario (#contacto).
BOOKING_URL=https://calendar.app.google/xxxxxxxxxxxx
# Medicion. Sin valor no se carga nada ni aparece el aviso de cookies.
# Google Analytics 4 → Administrar → Flujos de datos → ID de medicion (G-XXXXXXX).
GA_ID=G-XXXXXXXXXX
# Meta Events Manager → Origenes de datos → ID del pixel (solo digitos).
META_PIXEL_ID=000000000000000
# Search Console → Verificacion → Archivo HTML: el NOMBRE del archivo que entrega.
GSC_VERIFICATION_FILE=google0123456789abcdef.html
