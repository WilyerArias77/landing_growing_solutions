{
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://connect.facebook.net; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "prompts/**",
      "maxDuration": 30
    },
    "api/lead.js": {
      "maxDuration": 10
    },
    "api/keepalive.js": {
      "maxDuration": 10
    },
    "api/config.js": {
      "maxDuration": 5
    },
    "api/gsc.js": {
      "maxDuration": 5
    }
  },
  "redirects": [
    {
      "source": "/prompts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/db/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CHATBOT.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.env.example",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 13 * * 1,4"
    }
  ],
  "rewrites": [
    {
      "source": "/:file(google[0-9a-f]+)",
      "destination": "/api/gsc?file=:file.html"
    },
    {
      "source": "/:file(google[0-9a-f]+\\.html)",
      "destination": "/api/gsc?file=:file"
    }
  ]
}
